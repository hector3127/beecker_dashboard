# Copia este archivo como .env y llena los valores reales.
# Nunca subas el archivo .env ni key.json al repositorio.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Google Sheets: reemplaza a SpreadsheetApp.getActiveSpreadsheet().
# El ID es la parte de la URL entre /d/ y /edit.
GOOGLE_SPREADSHEET_ID=
# Ruta al JSON de la cuenta de servicio. Comparte el Sheet con el correo
# de esa cuenta (permiso de editor).
GOOGLE_CREDENTIALS_FILE=key.json

# Carpeta de Drive "Google Meet" con las notas de Gemini (minutas).
# Compartela con el correo de la cuenta de servicio (lector).
GOOGLE_MINUTES_FOLDER_ID=

# Origen de las horas reales que usa el dashboard:
#   clockify -> API de Clockify (se habilita al migrar ClockifyService.gs)
#   sheet    -> hoja Registros_Tiempo del mismo Sheet
TIME_ENTRY_SOURCE=clockify

# Cache del dashboard (equivale a CACHE_TTL_SECONDS de Config.gs).
DASHBOARD_CACHE_TTL_SECONDS=360
# Segundos que se reutilizan las hojas de Sheets (0 = sin cache).
SHEETS_READ_CACHE_SECONDS=900

# Credenciales que hoy viven en PropertiesService (fases siguientes).
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PAT=
# Team Project inicial del panel Daily (se cambia desde el selector).
AZURE_DEVOPS_PROJECT=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Inicio de sesion con Google (Extension de proyecto en Gmail).
# Cliente OAuth tipo "Aplicacion web"; redirige a
# http://127.0.0.1:8000/gmail/oauth/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Dominios permitidos separados por coma, por ejemplo beecker.ai.
GOOGLE_OAUTH_ALLOWED_DOMAINS=
# draft = crea borrador en el hilo (recomendado); send = envia directo.
GMAIL_DELIVERY_MODE=draft
